OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024

RESEARCH_MODE=balanced
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCH_RESULTS=8
MAX_PAGES_PER_ITERATION=5
MAX_TOOL_CALLS=40
MAX_TOOL_ROUNDS=8
HTTP_TIMEOUT_SEC=20
MAX_PAGE_BYTES=1500000
MAX_QUESTION_LENGTH=4000

STRUCTURED_OUTPUT_RETRIES=2
# SKIP_LLM_PAGE_EXTRACT=true   # optional override; unset = derive from RESEARCH_MODE

USE_LDR_LOOP=true
FETCH_FULL_PAGE=false

ENABLE_SUMMARY_STREAMING=true
SSE_POLL_INTERVAL_SEC=0.4

API_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/research.sqlite3
